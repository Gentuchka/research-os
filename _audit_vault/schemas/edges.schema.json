{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.local/schemas/edges.schema.json",
  "title": "TypedEdge",
  "type": "object",
  "additionalProperties": false,
  "required": ["from_id", "to_id", "edge_type", "created_at", "transaction_id"],
  "properties": {
    "from_id": { "type": "string" },
    "to_id": { "type": "string" },
    "edge_type": {
      "type": "string",
      "enum": [
        "strengthens",
        "weakens",
        "generalizes",
        "specializes",
        "depends_on",
        "uses",
        "proved_by",
        "disproved_by",
        "kills",
        "extends",
        "derived_from",
        "motivated_by",
        "requires",
        "supersedes",
        "cites"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "transaction_id": { "type": "string" }
  }
}
